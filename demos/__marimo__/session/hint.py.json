          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h1 id=\"hint-annotate-a-widget-in-the-notebook-itself\">Hint -- annotate a widget in the notebook itself</h1>\n<span class=\"paragraph\"><code>Hint</code> wraps a live widget and curves an arrow from a short note to the\nwidget's edge, so a reader knows what to interact with and why.</span>\n<span class=\"paragraph\">It is a marimo-only display helper, not an <code>AnyWidget</code>. Display it as the\nlast expression of a cell and keep reading <code>.value</code> off the widget you\npassed in -- <code>Hint</code> never gets in the way of your data.</span></span>"
          }
        }
      ],
      "console": []
    },
